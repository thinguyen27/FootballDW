      <MdxScripts>
        <MdxScript>
          <ID>MdxScript</ID>
          <Name>MdxScript</Name>
          <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
          <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
          <Commands>
            <Command>
              <Text>/*
Cube Kỷ luật và Trọng tài (Phần 4) – fact Lượt ra sân (fact_player_appearance), Trận đấu điều hành (DistinctCount match_key) và Cầu thủ ra sân (DistinctCount player_key).
Trả lời: 
  - Trọng tài nào rút thẻ nghiêm khắc nhất (thẻ/trận)?
  - Bảng xếp hạng Fair-play của các CLB (điểm kỷ luật FIFA)?
  - Cơ cấu thẻ phạt theo Vị trí thi đấu (Hậu vệ, Tiền vệ, Tiền đạo, Thủ môn)?
  - Tần suất nhận thẻ: thi đấu bao nhiêu phút thì dính 1 thẻ vàng?
  - Tỉ số Cống hiến / Kỷ luật (Bàn thắng trên mỗi thẻ phạt nhận phải)?
  - Trung bình thẻ phạt trên mỗi cầu thủ thi đấu?
  - Mức độ căng thẳng giữa các Vòng knock-out vs Vòng đấu bảng.
Hỗ trợ Ban tổ chức giải giám sát công tác trọng tài, phân công trọng tài bắt các trận cầu đinh, và giúp Ban huấn luyện CLB xây dựng chiến thuật thi đấu kỷ luật, tránh án phạt treo giò.
*/
CALCULATE;

/* ===== PHẦN 4: KỶ LUẬT VÀ TRỌNG TÀI SÂN CỎ ===== */

/* 1. Tổng số thẻ phạt (Thẻ vàng + Thẻ đỏ) */
CREATE MEMBER CURRENTCUBE.[Measures].[Tổng thẻ phạt] AS
    [Measures].[Thẻ vàng] + [Measures].[Thẻ đỏ],
    FORMAT_STRING = "#,##0",
    VISIBLE = 1,
    ASSOCIATED_MEASURE_GROUP = 'Kỷ luật thi đấu';

/* 2. Điểm trừ kỷ luật Fair-play chuẩn FIFA (Thẻ vàng = 1 điểm, Thẻ đỏ = 3 điểm) */
CREATE MEMBER CURRENTCUBE.[Measures].[Điểm kỷ luật Fair Play] AS
    ([Measures].[Thẻ vàng] * 1) + ([Measures].[Thẻ đỏ] * 3),
    FORMAT_STRING = "#,##0",
    VISIBLE = 1,
    ASSOCIATED_MEASURE_GROUP = 'Kỷ luật thi đấu';

/* 3. Số thẻ trung bình mỗi trận (Độ nghiêm khắc trọng tài / Mức độ quyết liệt của giải) */
CREATE MEMBER CURRENTCUBE.[Measures].[Thẻ mỗi trận] AS
    IIF([Measures].[Số trận đấu] = 0 OR ISEMPTY([Measures].[Số trận đấu]), 
        NULL, 
        [Measures].[Tổng thẻ phạt] / [Measures].[Số trận đấu]
    ),
    FORMAT_STRING = "0.00",
    VISIBLE = 1,
    ASSOCIATED_MEASURE_GROUP = 'Kỷ luật thi đấu';

/* 4. Số thẻ vàng trung bình mỗi trận */
CREATE MEMBER CURRENTCUBE.[Measures].[Thẻ vàng mỗi trận] AS
    IIF([Measures].[Số trận đấu] = 0 OR ISEMPTY([Measures].[Số trận đấu]), 
        NULL, 
        [Measures].[Thẻ vàng] / [Measures].[Số trận đấu]
    ),
    FORMAT_STRING = "0.00",
    VISIBLE = 1,
    ASSOCIATED_MEASURE_GROUP = 'Kỷ luật thi đấu';

/* 5. Số thẻ đỏ trung bình mỗi trận */
CREATE MEMBER CURRENTCUBE.[Measures].[Thẻ đỏ mỗi trận] AS
    IIF([Measures].[Số trận đấu] = 0 OR ISEMPTY([Measures].[Số trận đấu]), 
        NULL, 
        [Measures].[Thẻ đỏ] / [Measures].[Số trận đấu]
    ),
    FORMAT_STRING = "0.000",
    VISIBLE = 1,
    ASSOCIATED_MEASURE_GROUP = 'Kỷ luật thi đấu';

/* 6. Điểm kỷ luật trung bình mỗi trận */
CREATE MEMBER CURRENTCUBE.[Measures].[Điểm kỷ luật mỗi trận] AS
    IIF([Measures].[Số trận đấu] = 0 OR ISEMPTY([Measures].[Số trận đấu]), 
        NULL, 
        [Measures].[Điểm kỷ luật Fair Play] / [Measures].[Số trận đấu]
    ),
    FORMAT_STRING = "0.00",
    VISIBLE = 1,
    ASSOCIATED_MEASURE_GROUP = 'Kỷ luật thi đấu';

/* 7. Tần suất nhận thẻ vàng: Cứ bao nhiêu phút thi đấu thì nhận 1 thẻ */
CREATE MEMBER CURRENTCUBE.[Measures].[Phút mỗi thẻ vàng] AS
    IIF([Measures].[Thẻ vàng] = 0 OR ISEMPTY([Measures].[Thẻ vàng]), 
        NULL, 
        [Measures].[Số phút thi đấu] / [Measures].[Thẻ vàng]
    ),
    FORMAT_STRING = "#,##0",
    VISIBLE = 1,
    ASSOCIATED_MEASURE_GROUP = 'Kỷ luật thi đấu';

/* 8. Tỉ lệ thẻ đỏ trên tổng thẻ phạt */
CREATE MEMBER CURRENTCUBE.[Measures].[Tỉ lệ thẻ đỏ] AS
    IIF([Measures].[Tổng thẻ phạt] = 0 OR ISEMPTY([Measures].[Tổng thẻ phạt]), 
        NULL, 
        [Measures].[Thẻ đỏ] / [Measures].[Tổng thẻ phạt]
    ),
    FORMAT_STRING = "0.00%",
    VISIBLE = 1,
    ASSOCIATED_MEASURE_GROUP = 'Kỷ luật thi đấu';

/* 9. Tỉ số Cống hiến / Kỷ luật (Bàn thắng trên mỗi thẻ phạt) */
CREATE MEMBER CURRENTCUBE.[Measures].[Bàn thắng trên mỗi thẻ] AS
    IIF([Measures].[Tổng thẻ phạt] = 0 OR ISEMPTY([Measures].[Tổng thẻ phạt]), 
        NULL, 
        [Measures].[Bàn thắng] / [Measures].[Tổng thẻ phạt]
    ),
    FORMAT_STRING = "0.00",
    VISIBLE = 1,
    ASSOCIATED_MEASURE_GROUP = 'Kỷ luật thi đấu';

/* 10. Trung bình thẻ phạt trên mỗi cầu thủ ra sân */
CREATE MEMBER CURRENTCUBE.[Measures].[Thẻ mỗi cầu thủ] AS
    IIF([Measures].[Số cầu thủ ra sân] = 0 OR ISEMPTY([Measures].[Số cầu thủ ra sân]), 
        NULL, 
        [Measures].[Tổng thẻ phạt] / [Measures].[Số cầu thủ ra sân]
    ),
    FORMAT_STRING = "0.00",
    VISIBLE = 1,
    ASSOCIATED_MEASURE_GROUP = 'Kỷ luật thi đấu';
</Text>
            </Command>
          </Commands>
        </MdxScript>
      </MdxScripts>
      <Kpis>
        <Kpi>
          <ID>Kpi Fair Play</ID>
          <Name>Chỉ số Fair Play CLB</Name>
          <AssociatedMeasureGroupID>Fact Player Appearance Discipline</AssociatedMeasureGroupID>
          <Value>[Measures].[Thẻ mỗi trận]</Value>
          <Goal>3.0</Goal>
          <Status>CASE 
    WHEN KPIValue("Chỉ số Fair Play CLB") &lt;= KPIGoal("Chỉ số Fair Play CLB") THEN 1
    WHEN KPIValue("Chỉ số Fair Play CLB") &lt;= 4.0 THEN 0
    ELSE -1 
END</Status>
          <Trend>CASE 
    WHEN [Mùa giải].[Mùa giải].CurrentMember.Level.Ordinal = 0 THEN 0 
    WHEN ISEMPTY(([Measures].[Thẻ mỗi trận], [Mùa giải].[Mùa giải].CurrentMember.PrevMember)) THEN 0 
    WHEN [Measures].[Thẻ mỗi trận] &lt; ([Measures].[Thẻ mỗi trận], [Mùa giải].[Mùa giải].CurrentMember.PrevMember) THEN 1 
    WHEN [Measures].[Thẻ mỗi trận] &gt; ([Measures].[Thẻ mỗi trận], [Mùa giải].[Mùa giải].CurrentMember.PrevMember) THEN -1 
    ELSE 0 
END</Trend>
          <TrendGraphic>Standard Arrow</TrendGraphic>
          <StatusGraphic>Traffic Light</StatusGraphic>
        </Kpi>
        <Kpi>
          <ID>Kpi Referee Strictness</ID>
          <Name>Độ nghiêm khắc Trọng tài</Name>
          <AssociatedMeasureGroupID>Fact Player Appearance Discipline</AssociatedMeasureGroupID>
          <Value>[Measures].[Thẻ mỗi trận]</Value>
          <Goal>4.0</Goal>
          <Status>CASE 
    WHEN KPIValue("Độ nghiêm khắc Trọng tài") &gt;= 5.0 THEN 1
    WHEN KPIValue("Độ nghiêm khắc Trọng tài") &gt;= 3.5 THEN 0
    ELSE -1 
END</Status>
          <Trend>CASE 
    WHEN [Mùa giải].[Mùa giải].CurrentMember.Level.Ordinal = 0 THEN 0 
    WHEN ISEMPTY(([Measures].[Thẻ mỗi trận], [Mùa giải].[Mùa giải].CurrentMember.PrevMember)) THEN 0 
    WHEN [Measures].[Thẻ mỗi trận] &gt; ([Measures].[Thẻ mỗi trận], [Mùa giải].[Mùa giải].CurrentMember.PrevMember) THEN 1 
    WHEN [Measures].[Thẻ mỗi trận] &lt; ([Measures].[Thẻ mỗi trận], [Mùa giải].[Mùa giải].CurrentMember.PrevMember) THEN -1 
    ELSE 0 
END</Trend>
          <TrendGraphic>Standard Arrow</TrendGraphic>
          <StatusGraphic>Gauge - Ascending</StatusGraphic>
        </Kpi>
      </Kpis>
    </Cube>
  </Cubes>
